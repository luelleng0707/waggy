DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Python PPIE Agent (primary runtime)
PPIE_DATA_DIR=data
PORT=8000

# PPIE License (required for production)
ENGINE_LICENSE_KEY=wagtopia-ppie-licensed
ENGINE_LICENSE_EXPECTED=wagtopia-ppie-licensed

# API Security (legacy Node server)
API_KEYS=wagtopia-demo-key,ppie-dev-key
CLIENT_SECRET=wagtopia-hmac-secret-demo
JWT_SECRET=ppie-admin-jwt-demo-secret
ENCRYPTION_KEY=ppie-aes-256-encryption-key!!
