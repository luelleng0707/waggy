{
  "DogProfileInput": {
    "properties": {
      "name": {
        "type": "string",
        "title": "Name",
        "examples": [
          "dolly"
        ]
      },
      "primary_breed": {
        "type": "string",
        "title": "Primary Breed",
        "examples": [
          "Golden Retriever"
        ]
      },
      "secondary_breed": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Secondary Breed",
        "examples": [
          "Labrador Retriever"
        ]
      },
      "breed_split_pct": {
        "type": "number",
        "maximum": 100.0,
        "minimum": 0.0,
        "title": "Breed Split Pct",
        "default": 50.0
      },
      "age_years": {
        "type": "number",
        "exclusiveMinimum": 0.0,
        "title": "Age Years"
      },
      "weight_kg": {
        "type": "number",
        "exclusiveMinimum": 0.0,
        "title": "Weight Kg"
      },
      "current_environment": {
        "type": "string",
        "title": "Current Environment",
        "examples": [
          "Shanghai Summer"
        ]
      },
      "activity_level": {
        "type": "string",
        "title": "Activity Level",
        "default": "High",
        "examples": [
          "High"
        ]
      },
      "sex": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Sex"
      },
      "gender": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Gender"
      },
      "birthday": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Birthday",
        "examples": [
          "2021-03-15"
        ]
      },
      "height_cm": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "title": "Height Cm"
      },
      "bcs": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "title": "Bcs"
      },
      "observed_conditions": {
        "items": {
          "type": "string"
        },
        "type": "array",
        "title": "Observed Conditions"
      }
    },
    "type": "object",
    "required": [
      "name",
      "primary_breed",
      "age_years",
      "weight_kg",
      "current_environment"
    ],
    "title": "DogProfileInput"
  },
  "HTTPValidationError": {
    "properties": {
      "detail": {
        "items": {
          "$ref": "#/components/schemas/ValidationError"
        },
        "type": "array",
        "title": "Detail"
      }
    },
    "type": "object",
    "title": "HTTPValidationError"
  },
  "ValidationError": {
    "properties": {
      "loc": {
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ]
        },
        "type": "array",
        "title": "Location"
      },
      "msg": {
        "type": "string",
        "title": "Message"
      },
      "type": {
        "type": "string",
        "title": "Error Type"
      }
    },
    "type": "object",
    "required": [
      "loc",
      "msg",
      "type"
    ],
    "title": "ValidationError"
  }
}